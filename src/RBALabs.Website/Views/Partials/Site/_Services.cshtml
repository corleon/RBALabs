@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
  var kicker = Model.Value<string>("servicesKicker") ?? "What We Do";
  var titleCandidate = Model.Value<string>("servicesTitle");
  var title = string.IsNullOrWhiteSpace(titleCandidate) || titleCandidate.Trim().Equals("What We Do", StringComparison.OrdinalIgnoreCase)
    ? "End-to-end engineering for digital platforms"
    : titleCandidate;
  var leadCandidate = Model.Value<string>("servicesLead");
  var lead = string.IsNullOrWhiteSpace(leadCandidate) || leadCandidate.Trim().Equals("From platform strategy to delivery and support, we cover the full lifecycle of enterprise Umbraco and .NET systems.", StringComparison.OrdinalIgnoreCase)
    ? string.Empty
    : leadCandidate;

  var service1Title = Model.Value<string>("service1Title") ?? "Umbraco Development";
  var service1Text = Model.Value<string>("service1Text") ?? "Custom Umbraco builds with clean content architecture, editor-friendly backoffice setup, and strong long-term maintainability.";
  var service2Title = Model.Value<string>("service2Title") ?? ".NET Backend and APIs";
  var service2Text = Model.Value<string>("service2Text") ?? "Robust backend services, event-driven workflows, and API-first integrations designed for performance and resilience.";
  var service3Title = Model.Value<string>("service3Title") ?? "Platform Modernization";
  var service3Text = Model.Value<string>("service3Text") ?? "Incremental upgrades from legacy stacks to modern architecture with lower risk and clear migration roadmaps.";
  var service4Title = Model.Value<string>("service4Title") ?? "Performance and Support";
  var service4Text = Model.Value<string>("service4Text") ?? "Core Web Vitals optimization, infrastructure tuning, release support, and stable operations for high-load products.";
}
<section class="section" id="services" data-reveal>
  <div class="section-head">
    <div>
      <span class="section-kicker">@kicker</span>
      <h2>@title</h2>
      @if (!string.IsNullOrWhiteSpace(lead))
      {
        <p class="muted">@lead</p>
      }
    </div>
  </div>

  <div class="service-grid" id="serviceGrid">
    <article class="service-card" data-reveal tabindex="0">
      <span class="service-icon service-icon-umbraco" aria-hidden="true">
        <svg viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="8"></circle>
          <path d="M9.4 8.8v5.1a2.6 2.6 0 0 0 5.2 0V8.8"></path>
        </svg>
      </span>
      <h3>@service1Title</h3>
      <p>@service1Text</p>
      <span class="service-arrow" aria-hidden="true">&rarr;</span>
      <span class="service-accent" aria-hidden="true"></span>
    </article>

    <article class="service-card" data-reveal tabindex="0">
      <span class="service-icon service-icon-dotnet" aria-hidden="true">
        <svg viewBox="0 0 24 24">
          <rect x="3.5" y="5.5" width="17" height="13" rx="3"></rect>
          <path d="m9.2 10.2-2.3 1.8 2.3 1.8M14.8 10.2l2.3 1.8-2.3 1.8"></path>
        </svg>
      </span>
      <h3>@service2Title</h3>
      <p>@service2Text</p>
      <span class="service-arrow" aria-hidden="true">&rarr;</span>
      <span class="service-accent" aria-hidden="true"></span>
    </article>

    <article class="service-card" data-reveal tabindex="0">
      <span class="service-icon service-icon-modernization" aria-hidden="true">
        <svg viewBox="0 0 24 24">
          <path d="M12 4.6v2.6M12 16.8v2.6M6.3 7.2 8 9M16 15l1.7 1.8M4.7 12h2.6M16.7 12h2.6M6.3 16.8 8 15M16 9l1.7-1.8"></path>
          <circle cx="12" cy="12" r="3.2"></circle>
        </svg>
      </span>
      <h3>@service3Title</h3>
      <p>@service3Text</p>
      <span class="service-arrow" aria-hidden="true">&rarr;</span>
      <span class="service-accent" aria-hidden="true"></span>
    </article>

    <article class="service-card" data-reveal tabindex="0">
      <span class="service-icon service-icon-support" aria-hidden="true">
        <svg viewBox="0 0 24 24">
          <path d="M12 5.5a7 7 0 1 0 7 7"></path>
          <path d="M12 8v4.2l2.7 1.6"></path>
        </svg>
      </span>
      <h3>@service4Title</h3>
      <p>@service4Text</p>
      <span class="service-arrow" aria-hidden="true">&rarr;</span>
      <span class="service-accent" aria-hidden="true"></span>
    </article>
  </div>
</section>
